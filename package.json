{
  "name": "youtube-auto-feed",
  "version": "0.2.3",
  "private": false,
  "description": "Keeps your YouTube subscriptions feed current as videos are published, removed, or change state - no page reload needed.",
  "keywords": [
    "browser-extension",
    "feed",
    "live-feed",
    "manifest-v3",
    "subscriptions",
    "wxt",
    "youtube"
  ],
  "homepage": "https://github.com/avi12/youtube-auto-feed",
  "bugs": {
    "url": "https://github.com/avi12/youtube-auto-feed/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "Avi (https://avi12.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avi12/youtube-auto-feed.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.svelte"
  ],
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "dev:edge-chrome-no-extension": "tsx scripts/dev-server.ts --edge --chrome.no-extension",
    "dev:edge": "tsx scripts/dev-server.ts --edge",
    "dev:edge-firefox-chrome-no-extension": "tsx scripts/dev-server.ts --edge --chrome.no-extension --firefox",
    "build": "wxt build",
    "build:firefox": "bun run build -b firefox --mv3",
    "build:opera": "bun run build -b opera",
    "zip": "wxt zip",
    "zip:firefox": "bun run zip -b firefox --mv3",
    "zip:opera": "bun run zip -b opera",
    "crx": "bun run zip && tsx scripts/pack-crx.ts",
    "build:zip": "bun run zip",
    "build:zip:firefox": "bun run zip:firefox",
    "build:zip:opera": "bun run zip:opera",
    "build:zip:all": "bunx concurrently \"bun run zip\" \"bun run zip:firefox\" \"bun run zip:opera\" --names Chrome,Firefox,Opera",
    "compile": "tsc --noEmit",
    "lint": "avi12-lint",
    "postinstall": "wxt prepare",
    "lint:fix": "avi12-lint --fix",
    "svelte:check": "avi12-svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^26.6.5",
    "@wxt-dev/module-svelte": "2.0.5",
    "chokidar": "^5.0.0",
    "crx3": "2.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "3.23.1",
    "fallow": "2.103.0",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "lint-config": "github:avi12/lint-config#v0.12.0",
    "oxfmt": "^0.78.0",
    "oxlint": "1.90.0",
    "postcss": "^8.5.30",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-ccb": "^3.32.0",
    "svelte": "5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "1.9.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "web-ext-run": "^0.2.4",
    "wxt": "^0.21.4"
  },
  "packageManager": "bun@1.4.5",
  "patchedDependencies": {
    "zod@4.6.7": "patches/zod.patch"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "spawn-sync"
  ]
}
