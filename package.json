{
  "name": "youtube-auto-feed",
  "description": "Keeps your YouTube subscriptions feed current as videos are published, removed, or change state - no page reload needed.",
  "private": false,
  "version": "0.0.9",
  "license": "GPL-3.0-or-later",
  "author": "Avi (https://avi12.com)",
  "homepage": "https://github.com/avi12/youtube-auto-feed",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avi12/youtube-auto-feed.git"
  },
  "bugs": {
    "url": "https://github.com/avi12/youtube-auto-feed/issues"
  },
  "keywords": [
    "youtube",
    "subscriptions",
    "feed",
    "browser-extension",
    "wxt",
    "manifest-v3",
    "live-feed"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.svelte"
  ],
  "packageManager": "pnpm@11.2.1+sha512.4c4c142b276348da01d39907cce2f40bf61281212a0e43295ee988055d50cce728ab7e9c181e252e4bce3a4f19ba1cff1a75b1e2e0fd6b17ba0be598a5e45446",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "dev:edge-chrome-no-extension": "tsx scripts/dev-server.ts --edge --chrome.no-extension",
    "dev:edge": "tsx scripts/dev-server.ts --edge",
    "dev:edge-firefox-chrome-no-extension": "tsx scripts/dev-server.ts --edge --chrome.no-extension --firefox",
    "build": "wxt build",
    "build:firefox": "pnpm build -b firefox --mv3",
    "build:opera": "pnpm build -b opera",
    "zip": "wxt zip",
    "zip:firefox": "pnpm zip -b firefox --mv3",
    "zip:opera": "pnpm zip -b opera",
    "build:zip": "pnpm build && pnpm zip",
    "build:zip:firefox": "pnpm build:firefox && pnpm zip:firefox",
    "build:zip:opera": "pnpm build:opera && pnpm zip:opera",
    "build:zip:all": "pnpx concurrently \"pnpm build && pnpm zip\" \"pnpm build:firefox && pnpm zip:firefox\" \"pnpm build:opera && pnpm zip:opera\" --names Chrome,Firefox,Opera",
    "compile": "tsc --noEmit",
    "lint": "oxlint --type-aware --fix && eslint --fix",
    "lint:style": "stylelint \"src/**/*.{css,svelte}\" --fix",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-plugin": "5.2.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@wxt-dev/module-svelte": "2.0.5",
    "chokidar": "^5.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-svelte": "3.20.0",
    "fflate": "^0.8.3",
    "globals": "^17.7.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "postcss": "^8.5.16",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.14.0",
    "stylelint-config-ccb": "^3.32.0",
    "svelte": "5.56.4",
    "svelte-eslint-parser": "1.8.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "web-ext-run": "^0.2.4",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "@webext-core/messaging": "^3.0.2",
    "zod": "^4.4.3"
  }
}
