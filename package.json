{
  "name": "youtube-auto-feed",
  "description": "Keeps your YouTube subscriptions feed current as videos are published, removed, or change state - no page reload needed.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx dev.ts",
    "dev:watch": "tsx dev.ts --watch --edge --chrome",
    "dev:chrome:without-extension": "tsx dev.ts --watch --chrome",
    "dev:edge": "tsx dev.ts --edge",
    "dev:opera": "tsx dev.ts --opera",
    "dev:firefox": "tsx dev.ts --firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint --fix",
    "lint:style": "stylelint . --fix",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/yargs": "^17.0.35",
    "@wxt-dev/auto-icons": "^1.1.1",
    "chokidar": "^5.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "globals": "^17.5.0",
    "postcss": "^8.5.12",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.9.1",
    "stylelint-config-ccb": "^3.31.4",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "web-ext-run": "^0.2.4",
    "wxt": "^0.20.25"
  },
  "dependencies": {
    "yargs": "^18.0.0"
  }
}
