{
  "name": "youtube-now-feed",
  "description": "Keeps your YouTube subscriptions feed current as videos are published, removed, or change state - no page reload needed.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun dev.ts",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint --fix",
    "lint:style": "stylelint . --fix",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "chokidar": "^5.0.0",
    "eslint": "^10.2.0",
    "eslint-plugin-perfectionist": "^5.8.0",
    "globals": "^17.5.0",
    "perfect-debounce": "^2.1.0",
    "postcss": "^8.5.10",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.8.0",
    "stylelint-config-ccb": "^3.31.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "wxt": "^0.20.22"
  }
}
