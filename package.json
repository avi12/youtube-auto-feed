{
  "name": "youtube-auto-feed",
  "version": "0.2.3",
  "private": false,
  "description": "Keeps your YouTube subscriptions feed current as videos are published, removed, or change state - no page reload needed.",
  "keywords": [
    "browser-extension",
    "feed",
    "live-feed",
    "manifest-v3",
    "subscriptions",
    "wxt",
    "youtube"
  ],
  "homepage": "https://github.com/avi12/youtube-auto-feed",
  "bugs": {
    "url": "https://github.com/avi12/youtube-auto-feed/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "Avi (https://avi12.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avi12/youtube-auto-feed.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.svelte"
  ],
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "dev:edge-chrome-no-extension": "tsx scripts/dev-server.ts --edge --chrome.no-extension",
    "dev:edge": "tsx scripts/dev-server.ts --edge",
    "dev:edge-firefox-chrome-no-extension": "tsx scripts/dev-server.ts --edge --chrome.no-extension --firefox",
    "build": "wxt build",
    "build:firefox": "pnpm build -b firefox --mv3",
    "build:opera": "pnpm build -b opera",
    "zip": "wxt zip",
    "zip:firefox": "pnpm zip -b firefox --mv3",
    "zip:opera": "pnpm zip -b opera",
    "crx": "pnpm zip && tsx scripts/pack-crx.ts",
    "build:zip": "pnpm zip",
    "build:zip:firefox": "pnpm zip:firefox",
    "build:zip:opera": "pnpm zip:opera",
    "build:zip:all": "pnpx concurrently \"pnpm zip\" \"pnpm zip:firefox\" \"pnpm zip:opera\" --names Chrome,Firefox,Opera",
    "compile": "tsc --noEmit",
    "lint": "avi12-lint",
    "postinstall": "wxt prepare",
    "lint:fix": "avi12-lint --fix",
    "svelte:check": "avi12-svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^26.6.5",
    "@wxt-dev/module-svelte": "2.0.5",
    "avi12-lint": "github:avi12/lint-config#v0.11.0&path:/packages/avi12-lint",
    "chokidar": "^5.0.0",
    "crx3": "2.0.0",
    "eslint": "^10.12.0",
    "eslint-config-avi12": "github:avi12/lint-config#v0.11.0&path:/packages/eslint-config",
    "eslint-plugin-svelte": "3.23.1",
    "fallow": "2.103.0",
    "fallow-config-avi12": "github:avi12/lint-config#v0.11.0&path:/packages/fallow-config",
    "fflate": "^0.8.3",
    "oxfmt": "^0.78.0",
    "oxfmt-config-avi12": "github:avi12/lint-config#v0.11.0&path:/packages/oxfmt-config",
    "oxlint": "1.90.0",
    "oxlint-config-avi12": "github:avi12/lint-config#v0.11.0&path:/packages/oxlint-config",
    "oxlint-plugin-naming": "github:avi12/lint-config#v0.11.0&path:/packages/oxlint-plugin-naming",
    "postcss": "^8.5.30",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-avi12": "github:avi12/lint-config#v0.11.0&path:/packages/stylelint-config",
    "svelte": "5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "1.9.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "web-ext-run": "^0.2.4",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
