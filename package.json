{
  "name": "youtube-auto-feed",
  "description": "Keeps your YouTube subscriptions feed current as videos are published, removed, or change state - no page reload needed.",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.2.1+sha512.4c4c142b276348da01d39907cce2f40bf61281212a0e43295ee988055d50cce728ab7e9c181e252e4bce3a4f19ba1cff1a75b1e2e0fd6b17ba0be598a5e45446",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "dev:edge-chrome-no-extension": "tsx scripts/dev-server.ts --edge --chrome.no-extension",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "build:zip": "pnpm build && pnpm zip",
    "compile": "tsc --noEmit",
    "lint": "eslint --fix",
    "lint:style": "stylelint . --fix",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/yargs": "^17.0.35",
    "@wxt-dev/auto-icons": "^1.1.1",
    "chokidar": "^5.0.0",
    "eslint": "^10.4.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.12.0",
    "stylelint-config-ccb": "^3.31.5",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "web-ext-run": "^0.2.4",
    "wxt": "^0.20.26"
  },
  "dependencies": {
    "yargs": "^18.0.0"
  }
}
